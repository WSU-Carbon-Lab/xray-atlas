  @@index([azimuthdeg, polardeg], map: "idx_polarization_geom")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model peaksets {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentid String      @db.Uuid
  energyev     Float
  intensity    Float?
  bond         String?
  transition   String?
  createdat    DateTime    @default(now()) @db.Timestamptz(6)
  experiments  experiments @relation(fields: [experimentid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([experimentid])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model spectrumpoints {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentid      String         @db.Uuid
  energyev          Float
  rawabs            Float
  i0                Float?
  beta              Float?
  massabsorption    Float?
  od                Float?
  polarizationid    String?        @db.Uuid
  rawabserr         Float?
  oderr             Float?
  massabsorptionerr Float?
  betaerr           Float?
  delta             Float?
  deltaerr          Float?
  experiments       experiments    @relation(fields: [experimentid], references: [id], onDelete: Cascade, onUpdate: NoAction)
  polarizations     polarizations? @relation(fields: [polarizationid], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([experimentid, energyev], map: "spectrumpoints_experimentid_energyev_null_pol_key", where: raw("(polarizationid IS NULL)"))
  @@unique([experimentid, polarizationid, energyev], where: raw("(polarizationid IS NOT NULL)"))
  @@index([experimentid, energyev], map: "idx_spectrum_energy")
  @@index([experimentid, polarizationid, energyev], map: "idx_spectrum_experiment_polarization_energy")
  @@index([polarizationid, experimentid], map: "idx_spectrum_polarization_experiment")
  @@schema("public")
}

/// Immutable revision of the contributor-controlled processing parameters of an experiment.
/// `changeKind` is `baseline`, `normalization`, `kk_first_calculation`, `kk_recalculation`,
/// `aux_added`, or `aux_removed` (a combined change stores the highest-impact kind). `derivedChecksum`
/// is the SHA-256 hex of canonical JSON of the derived columns, computed in application code.
model ExperimentRevision {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId    String                   @map("experiment_id") @db.Uuid
  versionMajor    Int                      @map("version_major")
  versionMinor    Int                      @map("version_minor")
  versionPatch    Int                      @map("version_patch")
  actorUserId     String?                  @map("actor_user_id") @db.VarChar(19)
  changeKind      String                   @map("change_kind") @db.VarChar(32)
  parameters      Json
  derivedChecksum String                   @map("derived_checksum") @db.VarChar(64)
  kkDelta         Json?                    @map("kk_delta")
  zenodoVersionId String?                  @map("zenodo_version_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  experiments     experiments              @relation(fields: [experimentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor           user?                    @relation("ExperimentRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  zenodoVersion   ExperimentZenodoVersion? @relation(fields: [zenodoVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([experimentId, versionMajor, versionMinor, versionPatch], map: "experiment_revisions_experiment_version_key")
  @@index([experimentId, createdAt], map: "idx_experiment_revisions_experiment_created")
  @@index([zenodoVersionId], map: "idx_experiment_revisions_zenodo_version_id")
  @@map("experiment_revisions")
  @@schema("public")
}

/// Groups auxiliary-file changes made in one editing session into a single version bump.
/// `changes` holds `aux_added` / `aux_removed` markers; `closedAt` is null while the session is open.
model ExperimentAuxSession {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId String      @map("experiment_id") @db.Uuid
  actorUserId  String      @map("actor_user_id") @db.VarChar(19)
  changes      String[]    @default([])
  openedAt     DateTime    @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt     DateTime?   @map("closed_at") @db.Timestamptz(6)
  experiments  experiments @relation(fields: [experimentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor        user        @relation("ExperimentAuxSessionActor", fields: [actorUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([experimentId, closedAt], map: "idx_experiment_aux_sessions_experiment_closed")
  @@index([actorUserId], map: "idx_experiment_aux_sessions_actor_user_id")
  @@map("experiment_aux_sessions")
  @@schema("public")
}
