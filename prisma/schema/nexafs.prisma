/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model experiments {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sampleid                    String                       @db.Uuid
  instrumentid                String
  edgeid                      String                       @db.Uuid
  polarizationid              String                       @db.Uuid
  calibrationid               String?                      @db.Uuid
  isstandard                  Boolean                      @default(false)
  referencestandard           String?
  createdby                   String?
  createdat                   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedat                   DateTime                     @default(now()) @db.Timestamptz(6)
  experimenttype              ExperimentType?
  nexafsexperimentkindid      String?                      @db.Uuid
  collectedbyuserids          String[]                     @default([]) @map("collected_by_user_ids")
  normalizationscope          String?                      @map("normalization_scope")
  normalizationranges         Json?                        @map("normalization_ranges")
  uploadedchannels            Json?                        @map("uploaded_channels")
  channelprovenance           Json?                        @map("channel_provenance")
  validationsummary           Json?                        @map("validation_summary")
  qualityscores               Json?                        @map("quality_scores")
  kkdeltametadata             Json?                        @map("kk_delta_metadata")
  datasetVersionMajor         Int                          @default(1) @map("dataset_version_major")
  datasetVersionMinor         Int                          @default(0) @map("dataset_version_minor")
  datasetVersionPatch         Int                          @default(0) @map("dataset_version_patch")
  canonicalslug               String?                      @unique(where: raw("(canonical_slug IS NOT NULL)")) @map("canonical_slug")
  atlasdatasetid              String?                      @unique(where: raw("(atlas_dataset_id IS NOT NULL)")) @map("atlas_dataset_id") @db.VarChar(16)
  experimentcontributors      experimentcontributors[]
  experimentfavorites         experimentfavorites[]
  experimentfiles             experimentfile[]
  experimentmetrics           experimentmetrics?
  experimentmetricschannels   experimentmetricschannel[]   @relation("ExperimentMetricsChannelHeader")
  experimentpublications      experimentpublications[]
  experimentquality           experimentquality?
  calibrationmethods          calibrationmethods?          @relation(fields: [calibrationid], references: [id], onUpdate: NoAction)
  edges                       edges                        @relation(fields: [edgeid], references: [id], onUpdate: NoAction)
  instruments                 instruments                  @relation(fields: [instrumentid], references: [id], onUpdate: NoAction)
  nexafsexperimentkind        nexafsexperimentkinds?       @relation(fields: [nexafsexperimentkindid], references: [id], onUpdate: NoAction)
  polarizations               polarizations                @relation(fields: [polarizationid], references: [id], onUpdate: NoAction)
  samples                     samples                      @relation(fields: [sampleid], references: [id], onUpdate: NoAction)
  peaksets                    peaksets[]
  spectrumpoints              spectrumpoints[]
  dashboardprocessingsessions dashboardprocessingsession[]
  experimentzenododeposit     experimentzenododeposits?
  revisions                   ExperimentRevision[]
  zenodoVersions              ExperimentZenodoVersion[]
  zenodoSyncJobs              ZenodoSyncJob[]
  auxSessions                 ExperimentAuxSession[]

  @@index([sampleid, edgeid, instrumentid], map: "idx_experiment_lookup")
  @@index([calibrationid], map: "idx_experiments_calibrationid")
  @@index([createdby], map: "idx_experiments_createdby")
  @@index([edgeid], map: "idx_experiments_edgeid")
  @@index([instrumentid], map: "idx_experiments_instrumentid")
  @@index([polarizationid], map: "idx_experiments_polarizationid")
  @@index([nexafsexperimentkindid], map: "idx_experiments_nexafs_kindid")
  @@schema("public")
}

model experimentcontributors {
  id                     String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentid           String                           @map("experiment_id") @db.Uuid
  orcidid                String                           @map("orcid_id") @db.VarChar(19)
  userid                 String?                          @map("user_id") @db.VarChar(19)
  role                   String
  isclaimed              Boolean                          @default(false) @map("is_claimed")
  ispublicprofilevisible Boolean                          @default(false) @map("is_public_profile_visible")
  claimstatus            ExperimentContributorClaimStatus @default(pending) @map("claim_status")
  detachedat             DateTime?                        @map("detached_at") @db.Timestamptz(6)
  claimedat              DateTime?                        @map("claimed_at") @db.Timestamptz(6)
  createdat              DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedat              DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  experiments            experiments                      @relation(fields: [experimentid], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                   user?                            @relation(fields: [userid], references: [id], onUpdate: NoAction)

  @@unique([experimentid, orcidid, role], map: "experiment_contributors_unique_role")
  @@index([experimentid], map: "idx_experiment_contributors_experiment_id")
  @@index([orcidid], map: "idx_experiment_contributors_orcid_id")
  @@index([userid], map: "idx_experiment_contributors_user_id")
  @@index([orcidid, claimstatus], map: "idx_experiment_contributors_orcid_claim_status")
  @@map("experiment_contributors")
  @@schema("public")
}

model nexafsexperimentkinds {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token          String         @unique
  label          String
  experimenttype ExperimentType @unique
  createdat      DateTime       @default(now()) @db.Timestamptz(6)
  updatedat      DateTime       @default(now()) @db.Timestamptz(6)
  experiments    experiments[]

  @@schema("public")
}

