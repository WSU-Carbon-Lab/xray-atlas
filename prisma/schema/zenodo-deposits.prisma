/// Tracks Atlas repository depositor Zenodo deposits for per-experiment dataset DOIs.
/// One row per experiment in v1; workflow state stays separate from bibliographic `publications`.
model experimentzenododeposits {
  experimentid       String             @id @map("experiment_id") @db.Uuid
  state              ZenodoDepositState @default(pending)
  zenododepositionid Int?               @map("zenodo_deposition_id")
  zenodorecordid     Int?               @map("zenodo_record_id")
  doi                String?            @db.VarChar(256)
  recordurl          String?            @map("record_url") @db.Text
  conceptDoi         String?            @map("concept_doi") @db.VarChar(256)
  conceptRecordId    String?            @map("concept_record_id") @db.VarChar(32)
  errormessage       String?            @map("error_message") @db.Text
  attemptcount       Int                @default(0) @map("attempt_count")
  lastattemptat      DateTime?          @map("last_attempt_at") @db.Timestamptz(6)
  publishedat        DateTime?          @map("published_at") @db.Timestamptz(6)
  createdat          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedat          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  experiments        experiments        @relation(fields: [experimentid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([state], map: "idx_experiment_zenodo_deposits_state")
  @@index([doi], map: "idx_experiment_zenodo_deposits_doi", where: raw("(doi IS NOT NULL)"))
  @@map("experiment_zenodo_deposits")
  @@schema("public")
}

/// One published (or attempted) Zenodo version of an experiment's dataset record.
/// `versionLabel` is the Atlas dataset version `M.m.p` the Zenodo version carries.
/// `status` is one of `pending`, `published`, `failed`, `unrecoverable` (enforced by a CHECK constraint).
model ExperimentZenodoVersion {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId String               @map("experiment_id") @db.Uuid
  versionLabel String               @map("version_label") @db.VarChar(32)
  doi          String?              @db.VarChar(256)
  recordId     String?              @map("record_id") @db.VarChar(32)
  depositionId String?              @map("deposition_id") @db.VarChar(32)
  status       String               @default("pending") @db.VarChar(16)
  publishedAt  DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  experiments  experiments          @relation(fields: [experimentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  revisions    ExperimentRevision[]

  @@unique([experimentId, versionLabel], map: "experiment_zenodo_versions_experiment_label_key")
  @@index([experimentId], map: "idx_experiment_zenodo_versions_experiment_id")
  @@map("experiment_zenodo_versions")
  @@schema("public")
}

/// Durable queue entry that syncs one dataset version to Zenodo.
/// `mode` is `files` or `metadata`; `status` is `queued`, `running`, `done`, or `dead`.
model ZenodoSyncJob {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId       String      @map("experiment_id") @db.Uuid
  targetVersionLabel String      @map("target_version_label") @db.VarChar(32)
  mode               String      @db.VarChar(16)
  attempts           Int         @default(0)
  nextAttemptAt      DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError          String?     @map("last_error") @db.Text
  status             String      @default("queued") @db.VarChar(16)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  experiments        experiments @relation(fields: [experimentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([experimentId, targetVersionLabel, mode], map: "zenodo_sync_jobs_experiment_version_mode_key")
  @@index([status, nextAttemptAt], map: "idx_zenodo_sync_jobs_status_next_attempt")
  @@index([experimentId], map: "idx_zenodo_sync_jobs_experiment_id")
  @@map("zenodo_sync_jobs")
  @@schema("public")
}
